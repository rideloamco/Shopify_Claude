{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_size_guide = false -%}
{%- assign sg_label = 'Size guide' -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'size_guide' -%}
    {%- assign has_size_guide = true -%}
    {%- if b.settings.label != blank -%}{%- assign sg_label = b.settings.label -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}

<div class="product-page">

  {% render 'breadcrumbs' %}

  <!-- ══ Buy area: gallery + purchase controls ══ -->
  <div class="product-page__inner">
    <!-- Gallery -->
    <div class="product-page__gallery">
      <div class="product-page__main-image">
        {%- if product.featured_image -%}
          <img
            id="product-main-img"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="1200" height="1200" loading="eager">
        {%- else -%}
          <div class="product-card__placeholder" style="height:100%;display:flex;align-items:center;justify-content:center">
            {{ product.title | upcase }} · IMAGE
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-page__thumbs">
          {%- for image in product.images limit: 4 -%}
            <div class="product-page__thumb{% if forloop.first %} is-active{% endif %}" data-src="{{ image | image_url: width: 1200 }}">
              <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | default: product.title | escape }}" width="300" height="300" loading="lazy">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Purchase controls (kept above the fold) -->
    <div class="product-page__info">
      {%- for collection in product.collections limit: 1 -%}
        <p class="eyebrow" style="margin-bottom:12px">{{ collection.title }}</p>
      {%- endfor -%}

      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" style="margin-top:10px"></div>

      <div style="display:flex;align-items:baseline;gap:12px;margin-top:12px">
        <span class="product-page__price" id="product-price">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="product-page__compare-price" id="product-compare-price">{{ current_variant.compare_at_price | money }}</span>
        {%- else -%}
          <span class="product-page__compare-price" id="product-compare-price" style="display:none"></span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_low_stock
        and current_variant.inventory_management == 'shopify'
        and current_variant.inventory_policy == 'deny'
        and current_variant.inventory_quantity > 0
        and current_variant.inventory_quantity <= section.settings.low_stock_threshold -%}
        <p class="pdp-lowstock">Only {{ current_variant.inventory_quantity }} left — don't sleep on it</p>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="variant-selector">
            <div class="variant-selector__labelrow">
              <span class="variant-selector__label">{{ option.name }}</span>
              {%- if has_size_guide and forloop.first -%}
                <button type="button" class="pdp-sizeguide__link" data-sizeguide-open>{{ sg_label }} →</button>
              {%- endif -%}
            </div>
            <div class="variant-selector__options">
              {%- for value in option.values -%}
                {%- liquid
                  assign option_index = forloop.parentloop.index0
                  assign is_selected = false
                  if current_variant.options[option_index] == value
                    assign is_selected = true
                  endif
                  assign found_variant = nil
                  for variant in product.variants
                    if variant.options[option_index] == value
                      assign found_variant = variant
                      break
                    endif
                  endfor
                -%}
                <button
                  class="variant-option{% if is_selected %} is-selected{% endif %}{% unless found_variant.available %} is-unavailable{% endunless %}"
                  data-variant-id="{% if found_variant %}{{ found_variant.id }}{% endif %}"
                  data-price="{% if found_variant %}{{ found_variant.price }}{% endif %}"
                  data-compare-price="{% if found_variant %}{{ found_variant.compare_at_price }}{% endif %}"
                  data-available="{% if found_variant %}{{ found_variant.available }}{% else %}false{% endif %}">
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- if has_size_guide -%}
          <button type="button" class="pdp-sizeguide__link" data-sizeguide-open style="margin-top:24px">{{ sg_label }} →</button>
        {%- endif -%}
      {%- endunless -%}

      {%- if current_variant.available -%}
        <button class="product-add-to-cart" data-add-to-cart data-variant-id="{{ current_variant.id }}">ADD TO CART</button>
      {%- else -%}
        <button class="product-add-to-cart" disabled>SOLD OUT</button>
      {%- endif -%}

      {%- comment -%} Trust badges sit directly under Add to Cart {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' -%}
          <div class="product-trust" {{ block.shopify_attributes }}>
            {%- for i in (1..4) -%}
              {%- assign tkey = 'text_' | append: i -%}
              {%- assign ikey = 'icon_' | append: i -%}
              {%- assign tval = block.settings[tkey] -%}
              {%- if tval != blank -%}
                <div class="product-trust__item">
                  <span class="product-trust__icon">{% render 'pdp-icon', name: block.settings[ikey] %}</span>
                  {{ tval }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- ══ Details: description, features, media, collapsibles ══ -->
  <div class="product-page__details">
    {%- if product.description != blank -%}
      <div class="pdp-details__block">
        <h2 class="pdp-details__heading">Description</h2>
        <div class="product-page__desc">{{ product.description }}</div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'feature' -%}
          <div class="pdp-feature" {{ block.shopify_attributes }}>
            <span class="pdp-feature__icon">{% render 'pdp-icon', name: block.settings.icon %}</span>
            <div class="pdp-feature__body">
              {%- if block.settings.title != blank -%}<span class="pdp-feature__title">{{ block.settings.title }}</span> {% endif -%}
              <span class="pdp-feature__text">{{ block.settings.text }}</span>
            </div>
          </div>

        {%- when 'media' -%}
          {%- if block.settings.video_url != blank or block.settings.image != blank -%}
            <div class="pdp-media" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="pdp-details__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.video_url != blank -%}
                <video class="pdp-media__el" src="{{ block.settings.video_url }}" autoplay muted loop playsinline></video>
              {%- else -%}
                <img class="pdp-media__el" src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: product.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'collapsible' -%}
          <div class="pdp-collapsible" {{ block.shopify_attributes }}>
            <button class="pdp-collapsible__toggle" type="button" aria-expanded="false">
              <span>{{ block.settings.heading }}</span>
              <span class="pdp-collapsible__icon" aria-hidden="true">+</span>
            </button>
            <div class="pdp-collapsible__body">{{ block.settings.content }}</div>
          </div>

        {%- when 'text' -%}
          <div class="pdp-note" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <!-- ══ Reviews (Judge.me) ══ -->
  <div style="max-width:900px;margin:0 auto;padding:0 var(--space-6) clamp(72px,10vw,104px)">
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}"></div>
  </div>

  <!-- ══ People also bought (shows on every product page automatically) ══ -->
  {%- if section.settings.show_reco -%}
    {%- assign reco = collections[section.settings.reco_collection] -%}
    {%- if reco == blank or reco.products_count == 0 -%}
      {%- assign reco = product.collections.first -%}
    {%- endif -%}
    {%- if reco != blank and reco.products_count > 1 -%}
      <div class="pdp-reco">
        <h2 class="pdp-reco__heading">{{ section.settings.reco_heading | default: 'People also bought' }}</h2>
        <div class="pdp-reco__grid">
          {%- assign shown = 0 -%}
          {%- for p in reco.products -%}
            {%- if p.id != product.id -%}
              {% render 'product-card', card_product: p %}
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown >= section.settings.reco_count -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_sticky_atc != false -%}
    <div class="sticky-atc" aria-hidden="false">
      <div class="sticky-atc__info">
        <div class="sticky-atc__title">{{ product.title }}</div>
        <div class="sticky-atc__price">{{ current_variant.price | money }}</div>
      </div>
      <button class="sticky-atc__btn" type="button" data-sticky-atc>{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Size guide modal {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'size_guide' -%}
    <div class="pdp-sizeguide-overlay" id="pdp-sizeguide" {{ block.shopify_attributes }}>
      <div class="pdp-sizeguide-modal">
        <button class="pdp-sizeguide-close" type="button" data-sizeguide-close aria-label="Close size guide">✕</button>
        <h2 class="pdp-sizeguide-title">{{ block.settings.heading | default: 'Size guide' }}</h2>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | default: 'Size guide' | escape }}" loading="lazy" style="width:100%;height:auto;margin-bottom:20px">
        {%- endif -%}
        <div class="pdp-sizeguide-content">{{ block.settings.content }}</div>
      </div>
    </div>
  {%- endif -%}
{%- endfor -%}

{% schema %}
{
  "name": "Product Main",
  "settings": [
    { "type": "header", "content": "Options" },
    { "type": "checkbox", "id": "show_sticky_atc", "label": "Sticky add-to-cart bar (mobile)", "default": true },
    { "type": "checkbox", "id": "show_low_stock", "label": "Show low-stock warning", "default": true },
    { "type": "range", "id": "low_stock_threshold", "label": "Low-stock threshold", "min": 1, "max": 25, "step": 1, "default": 6, "info": "Show the warning when stock is at or below this number (needs inventory tracking on)." },
    { "type": "header", "content": "People also bought" },
    { "type": "checkbox", "id": "show_reco", "label": "Show 'People also bought' row", "default": true },
    { "type": "text", "id": "reco_heading", "label": "Heading", "default": "People also bought" },
    { "type": "collection", "id": "reco_collection", "label": "Collection (optional)", "info": "Leave blank to use this product's own collection automatically." },
    { "type": "range", "id": "reco_count", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "bolt", "options": [
          { "value": "bolt", "label": "Lightning" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "star", "label": "Star" }, { "value": "shipping", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "lock", "label": "Lock" }, { "value": "tag", "label": "Tag" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "FLOW" },
        { "type": "text", "id": "text", "label": "Text", "default": "Superlight fabric for maximum airflow and breathability." }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free UK shipping over £50. 30-day easy returns.</p>" }
      ]
    },
    {
      "type": "media",
      "name": "Video / image",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading (optional)" },
        { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Upload to Content → Files and paste the URL. Takes priority over the image." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "size_guide",
      "name": "Size guide",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Trigger link label", "default": "Size guide" },
        { "type": "text", "id": "heading", "label": "Popup heading", "default": "Size guide" },
        { "type": "image_picker", "id": "image", "label": "Size chart image" },
        { "type": "richtext", "id": "content", "label": "Extra notes / measurements", "default": "<p>Measurements are a guide based on average chest circumference. If you're between sizes, size up for a relaxed fit.</p>" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Icon 1", "default": "shipping", "options": [ { "value": "shipping", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }, { "value": "tag", "label": "Tag" }, { "value": "bolt", "label": "Lightning" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "text_1", "label": "Text 1", "default": "Free UK shipping over £50" },
        { "type": "select", "id": "icon_2", "label": "Icon 2", "default": "returns", "options": [ { "value": "shipping", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }, { "value": "tag", "label": "Tag" }, { "value": "bolt", "label": "Lightning" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "text_2", "label": "Text 2", "default": "30-day easy returns" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "default": "shield", "options": [ { "value": "shipping", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }, { "value": "tag", "label": "Tag" }, { "value": "bolt", "label": "Lightning" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "text_3", "label": "Text 3", "default": "40% crash replacement" },
        { "type": "select", "id": "icon_4", "label": "Icon 4", "default": "lock", "options": [ { "value": "shipping", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }, { "value": "tag", "label": "Tag" }, { "value": "bolt", "label": "Lightning" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "text_4", "label": "Text 4", "default": "Secure checkout" }
      ]
    },
    {
      "type": "text",
      "name": "Text / note",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Order by 2pm for next-day dispatch.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Main",
      "blocks": [
        { "type": "trust" },
        { "type": "size_guide" },
        { "type": "collapsible", "settings": { "heading": "Shipping & returns", "content": "<p>Free UK standard shipping on orders over £50 (£3.99 under). Express and next-day options at checkout. 30-day easy returns.</p>" } },
        { "type": "collapsible", "settings": { "heading": "Crash replacement", "content": "<p>Trashed your kit in a crash? We'll replace it at 40% off within a year of purchase.</p>" } },
        { "type": "collapsible", "settings": { "heading": "Care", "content": "<p>Machine wash cold (30°C), no fabric softener, hang dry.</p>" } }
      ]
    }
  ]
}
{% endschema %}
