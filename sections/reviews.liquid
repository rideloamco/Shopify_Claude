{% if section.settings.show_section %}
<section id="reviews" class="section-reviews">
  {% if section.settings.eyebrow != blank %}
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  {% endif %}
  {% if section.settings.heading != blank %}
    <h2 class="section-reviews__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {%- comment -%} Judge.me Reviews Carousel (needs the Judge.me app embed + carousel enabled in Judge.me) {%- endcomment -%}
  <div class="jdgm-carousel-wrapper" style="margin-top:32px"></div>
</section>
{% endif %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "paragraph", "content": "Shows the Judge.me Reviews Carousel. Turn this on once you have reviews in Judge.me. Requires the Judge.me app embed enabled (Theme editor → App embeds) and the Reviews Carousel turned on in Judge.me → Settings → Widgets." },
    { "type": "checkbox", "id": "show_section", "label": "Show reviews carousel", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT THE RIDERS SAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the dirt cult" }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
